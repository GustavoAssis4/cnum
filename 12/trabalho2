# Ajuste linear para determinar Req e b
function ajuste_linear_resistencia(I, V)
    X = hcat(ones(length(I)), I)  # Matriz com coluna de 1s e coluna de I
    β = X \ V  # Resolve o sistema pelo método dos mínimos quadrados
    return β[2], β[1]  # Retorna Req e b
end

Req, b = ajuste_linear_resistencia(I, V)
println("Resistência equivalente (Req) = $Req, Constante de ajuste (b) = $b")

