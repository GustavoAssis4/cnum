function ponto_medio(f, a, b)
    h = b - a
    return h*(f((a+b)/2))
end

function trapezio(f, a, b)
    h = b - a
    return h*(((1/2)*f(a))+((1/2)*f(b)))
end

function simpson(f, a, b)
    h = (b - a) / 2
    return h*(((1/3)*f(a))+((4/3)*f((a+b)/2))+((1/3)*f(b)))
end

function iw(f, i, a, b, t)
    s = 0
    c = a
    d = a + t
    while d <= b
        s += i(f, c, d)
        c = d
        d += t
    end
    return s
end

