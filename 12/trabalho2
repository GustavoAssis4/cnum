# Função para ajustar um modelo linear e retornar os coeficientes a1 e a2
function ajuste_linear(x, y)
    X = hcat(ones(length(x)), x)  # Matriz com coluna de 1s e coluna de x
    β = X \ y  # Resolve o sistema pelo método dos mínimos quadrados
    return β[1], β[2]  # Retorna a1 e a2
end

# Calculando para cada estação
for (estacao, (x, y)) in dados
    a1, a2 = ajuste_linear(x, y)
    println("Estação: $estacao -> a1 = $a1, a2 = $a2")
end

